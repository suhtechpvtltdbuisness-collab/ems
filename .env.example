# The browser always calls the same-origin path /api/* — the backend URL is
# never exposed. Requests are proxied to the real backend by the Vite dev server
# (below) in dev and by vercel.json rewrites in production.
VITE_BACKEND_PROXY_TARGET=http://localhost:4000
VITE_ADMIN_SITE_URL=https://admin.orga.cc
VITE_SITE_URL=https://orga.cc
VITE_GA_ID=G-XXXXXXXXXX
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_ADSENSE_CLIENT=
VITE_GOOGLE_SITE_VERIFICATION=